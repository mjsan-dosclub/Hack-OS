# Supabase project URL and public key are safe to expose in browser contexts.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only direct PostgreSQL connection string for Drizzle migrations.
# Never prefix this value with NEXT_PUBLIC_ or commit a populated .env.local.
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# Shared secret for the protected /api/cron/sync endpoint. Keep it server-side.
CRON_SECRET=

# Development AI provider: Ollama hosted by JarvisLabs.
# Set the exact OpenAI-compatible base URL, API key, and Ollama model tag from JarvisLabs.
# All ideator, co-pilot, evaluator, and optional scraper AI requests use this endpoint.
# Keep these values server-side; never use a NEXT_PUBLIC_ prefix.
JARVISLABS_API_KEY=
JARVISLABS_BASE_URL=
JARVISLABS_MODEL=gemma3:4b

# Google and Groq providers are intentionally disabled during the student test project.
# Re-enable only after the project has paid credits and the team explicitly changes providers.
