# Add these values to Vercel Project Settings > Environment Variables.
# Never commit populated production values or expose service credentials to NEXT_PUBLIC_*.

# Canonical public URL used for metadata, structured data, and identifiable OSM requests.
NEXT_PUBLIC_SITE_URL=https://radar.descienceosclub.com

# Supabase project values. The URL and anon key are public; the service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Drizzle direct PostgreSQL connection. Use the production connection string from Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Generate a long random secret (at least 32 bytes); Vercel Cron sends it as a Bearer token.
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Current AI provider for the student test deployment (JarvisLabs Ollama-compatible endpoint).
# Add only to the environments where AI features are enabled. Keep all three server-side.
JARVISLABS_API_KEY=YOUR_JARVISLABS_API_KEY
JARVISLABS_BASE_URL=YOUR_JARVISLABS_OPENAI_COMPATIBLE_BASE_URL
JARVISLABS_MODEL=gemma3:4b
