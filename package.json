{
  "name": "hack-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src tests scripts vitest.config.mts playwright.config.ts",
    "format:check": "biome format src tests scripts vitest.config.mts playwright.config.ts",
    "format": "biome format src tests scripts vitest.config.mts playwright.config.ts --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "scrape": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/run-scrapers.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.57.4",
    "ai": "^5.0.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.44.5",
    "framer-motion": "^12.23.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
